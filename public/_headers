# Headers for static assets served by the Workers Assets binding.
# API responses (/api/*, /img/*) set their own headers in the Worker.
# Inline scripts / onclick handlers in the templates require 'unsafe-inline';
# Turnstile needs challenges.cloudflare.com for script + frame.
# The gallery loads its stylesheet (and possibly fonts/images) from plushka.se.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://plushka.se; font-src 'self' data: https://plushka.se; img-src 'self' data: blob: https://plushka.se; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
