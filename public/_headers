# Headers for static assets served by the Workers Assets binding.
# API responses (/api/*, /img/*) set their own headers in the Worker.
# Inline scripts / onclick handlers in the templates require 'unsafe-inline';
# Turnstile needs challenges.cloudflare.com for script + frame.
# public/styles.css is a local copy of the plushka.se stylesheet; it still references two
# background images on plushka.se (img-src).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://plushka.se; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Versioned via ?v= query in the template, safe to cache long.
/styles.css
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable
